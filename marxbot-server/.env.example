# NVIDIA NIM (GLM-5) — required for LLM calls and query expansion
NIM_API_KEY=your_nim_api_key_here

# Qdrant vector database — cloud or self-hosted
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# System prompt file (defaults to ./Marxbot.md)
# MARXBOT_PROMPT_FILE=./Marxbot.md

# StudyBot prompt file (optional)
# STUDY_PROMPT_FILE=./study_helper_system_prompt.md
